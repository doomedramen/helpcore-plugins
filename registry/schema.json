{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "helpcore Plugin Registry",
  "type": "object",
  "required": ["plugins"],
  "additionalProperties": false,
  "properties": {
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/definitions/Plugin" }
    }
  },
  "definitions": {
    "Plugin": {
      "type": "object",
      "required": ["id", "name", "description", "version", "tier", "author", "homepage", "permissions", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique plugin identifier — lowercase, hyphen-separated",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name":        { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version":     { "type": "string", "minLength": 1 },
        "tier": {
          "type": "string",
          "enum": ["wasm", "bridge"],
          "description": "wasm = in-process WASM sandbox; bridge = external HTTP service"
        },
        "author":   { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["outbound_http", "user_data_read", "user_data_write", "conversations_read"]
          }
        },
        "source":      { "$ref": "#/definitions/Source" },
        "package":     { "$ref": "#/definitions/Package" },
        "setup_guide": { "type": "string", "format": "uri" }
      }
    },
    "Package": {
      "type": "object",
      "required": ["url", "sha256"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Verified .tar.gz package URL"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        }
      }
    },
    "Source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["github", "url", "local"]
        },
        "repo": {
          "type": "string",
          "description": "GitHub owner/repo",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "description": "Release tag (e.g. 1.1.0) or branch name (e.g. main)"
        },
        "wasm_asset": {
          "type": "string",
          "description": "Filename of the WASM binary attached to the GitHub release"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Direct download URL for the WASM binary"
        }
      },
      "if":   { "properties": { "type": { "const": "github" } }, "required": ["type"] },
      "then": { "required": ["repo", "ref"] }
    }
  }
}
